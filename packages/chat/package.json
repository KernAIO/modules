{
  "name": "@kernaio/module-chat",
  "version": "0.1.0",
  "description": "Kern chat module: channels, DMs, threads, reactions, mentions, read-state, search (server + Svelte client)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/KernAIO/modules",
    "directory": "packages/chat"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "migrations",
    "src/client"
  ],
  "exports": {
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "svelte": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./client/*": {
      "types": "./src/client/*",
      "svelte": "./src/client/*",
      "default": "./src/client/*"
    },
    "./migrations": "./migrations"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.client.json --threshold error",
    "lint": "biome check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@kernaio/contracts": "^0.1.0",
    "@kernaio/kernel": "^0.1.0",
    "@kernaio/sdk": "^0.1.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@tanstack/svelte-virtual": "^3.13.0",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-mention": "^3.30.0",
    "@tiptap/extensions": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@tiptap/suggestion": "^3.30.0",
    "drizzle-orm": "^0.45.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "pg": "^8.16.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
