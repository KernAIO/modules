{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["svelte"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.svelte", "src/contract/**/*.ts"]
}
